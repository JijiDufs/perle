    "ios:export": "UPDATE_IOS_FIXTURES=1 vitest run tests/ios-export.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
